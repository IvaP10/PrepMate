## Local defaults. For deployment set INTER_ENVIRONMENT=production, use HTTPS
## URLs/origins, set COOKIE_SECURE=true, and replace every blank secret.
ENVIRONMENT=development
INTER_ENVIRONMENT=development
DEVELOPMENT_AUTO_RELOAD=false
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_REPORT_MODEL=gpt-5-mini
OPENAI_RESUME_MODEL=gpt-4o-mini
OPENAI_QUESTION_MODEL=gpt-5-mini
OPENAI_TECHNICAL_MODEL=gpt-5.2
OPENAI_EVALUATION_MODEL=gpt-5-nano
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

MODEL_DEFAULT_POLICY=openai_required
MODEL_EXTERNAL_INPUT_COST_PER_M_TOKENS=0.75
MODEL_EXTERNAL_CACHED_INPUT_COST_PER_M_TOKENS=0.075
MODEL_EXTERNAL_OUTPUT_COST_PER_M_TOKENS=4.50
MODEL_EVALUATION_INPUT_COST_PER_M_TOKENS=0.20
MODEL_EVALUATION_CACHED_INPUT_COST_PER_M_TOKENS=0.02
MODEL_EVALUATION_OUTPUT_COST_PER_M_TOKENS=1.25
MODEL_MAX_INTERVIEW_COST_USD=0.75
MODEL_MAX_LIVE_EVALUATIONS_PER_INTERVIEW=12
MODEL_MONTHLY_BUDGET_USD=2500
MODEL_MONTHLY_WARN_RATIO=0.80
MODEL_MONTHLY_HARD_STOP_RATIO=0.98

KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_TIMEOUT_SECONDS=8
JWT_SECRET=
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=v1
# Managed-secret JSON containing old version-to-master-key mappings during rotation.
ENCRYPTION_KEYRING_JSON=
# Salt used to derive per-field encryption keys from ENCRYPTION_MASTER_KEY.
# REQUIRED in production. Existing deployments that previously relied on the
# old literal default should set this to "interai-field-encryption-v1" to
# preserve readability of existing encrypted columns; new deployments should
# pick a random high-entropy string and keep it stable.
ENCRYPTION_SALT=

PG_DBNAME=ai_interviewer
PG_USER=interai
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432

GOOGLE_CLIENT_ID=

SMTP_EMAIL=
SMTP_PASSWORD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required in production for payment reconciliation and launch health.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_EMAIL=

# Required in production for rate limits, WebSocket tickets, and session recovery.
# Prefer REDIS_URL for managed services because it carries private host,
# authentication, TLS, and database selection in one value.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
DB_POOL_MIN=2
DB_POOL_MAX=20

FREE_CREDITS_ON_SIGNUP=3
FREE_INTERVIEW_DAILY_CAP=3
MAX_REQUEST_BODY_MB=50
RESUME_MAX_FILE_SIZE_MB=4
MAX_RESUME_TEXT_LENGTH=50000
JWT_EXPIRATION_DAYS=30
RESUME_AI_FALLBACK_CONFIDENCE=0.72
# Private Docker-network service; never point production at a public executor.
# Private URL of the controller on a dedicated gVisor executor host.
PISTON_API_URL=http://executor.internal:8080/api/v2
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=7
PISTON_API_TOKEN=
INTERNAL_SERVICE_TOKEN=
SANDBOX_DOCKER_SOCKET=/run/user/1000/docker.sock
SANDBOX_BIND_ADDRESS=127.0.0.1
PISTON_TIMEOUT_SECONDS=10
PISTON_NORMAL_TIMEOUT_SECONDS=2
PISTON_ABSOLUTE_TIMEOUT_SECONDS=10
PISTON_MEMORY_LIMIT_BYTES=268435456
PISTON_PROCESS_LIMIT=32
PISTON_SOURCE_LIMIT_BYTES=20480
PISTON_OUTPUT_LIMIT_BYTES=65536
PISTON_EXPECTED_RUNTIMES=python,javascript,java,c++
TECHNICAL_CODING_ONLY=true
TECHNICAL_ALLOW_AUTHORED_FALLBACK=false
TECHNICAL_MIN_ACTIVE_PROBLEMS=48
TECHNICAL_MIN_CODING_PROBLEMS=48
TECHNICAL_BANK_VERSION=technical-bank-v1
TECHNICAL_REQUIRED_TAXONOMIES=arrays,hashing,prefix-sum,sliding-window,two-pointers,intervals,greedy,binary-search,stack,queue,linked-list,trees,heaps,graphs,backtracking,strings,tries,dynamic-programming,bit-manipulation
WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
RAW_VIDEO_RETENTION_HOURS=0
AUDIO_RETENTION_DAYS=0
MEDIA_UPLOAD_PROVIDER=local_manifest

SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=interai-api
# Leave empty for the bundled network-private Prometheus collector. External
# collectors must be configured to send this value as an Authorization bearer.
METRICS_BEARER_TOKEN=

PORT=8000
# Short accidental disconnect/refresh restoration window for active attempts.
SESSION_RECOVERY_GRACE_SECONDS=60
