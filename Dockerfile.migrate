FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-migrate.txt .
RUN python -m pip install --timeout 120 --retries 5 -r requirements-migrate.txt

COPY alembic.ini config.py security_utils.py ./
COPY migrations/alembic ./migrations/alembic

RUN useradd --create-home --uid 10001 interai \
    && chown -R interai:interai /app

USER interai
ENTRYPOINT ["python", "-m", "alembic"]
CMD ["upgrade", "head"]
