{
  "name": "prepmate-desktop",
  "version": "0.1.0-alpha.1",
  "description": "Local-first desktop interview coach",
  "author": "PrepMate contributors",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron .",
    "validate": "python3 ../scripts/verify_desktop_bundle.py",
    "prepackage": "npm run validate",
    "prepackage:dir": "npm run validate",
    "prepackage:mac": "npm run validate",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never",
    "package:mac": "electron-builder --mac --${PREPMATE_MAC_ARCH:-arm64} --publish never"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.prepmate.desktop",
    "productName": "PrepMate",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/prepmate-backend",
        "to": "backend"
      },
      {
        "from": "../Frontend/.next/standalone",
        "to": "frontend"
      },
      {
        "from": "../Frontend/.next/standalone/node_modules",
        "to": "frontend/node_modules"
      },
      {
        "from": "../Frontend/.next/static",
        "to": "frontend/.next/static"
      },
      {
        "from": "../Frontend/public",
        "to": "frontend/public"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "PrepMate uses the camera only when you enable optional video feedback.",
        "NSMicrophoneUsageDescription": "PrepMate uses the microphone only when you enable spoken practice.",
        "NSScreenCaptureUsageDescription": "PrepMate uses screen sharing only when you explicitly enable optional coaching feedback."
      },
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": ["nsis", "zip"]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Education",
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "PrepMate-${version}-${os}-${arch}.${ext}"
  }
}
