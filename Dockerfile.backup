FROM python:3.12.10-alpine3.22@sha256:9ba6d8cbebf0fb6546ae71f2a1c14f6ffd2fdab83af7fa5669734ef30ad48844

RUN apk add --no-cache postgresql16-client && pip install --no-cache-dir cryptography==49.0.0

WORKDIR /app
COPY scripts/backup_database.py scripts/restore_drill.py /app/scripts/

RUN addgroup -S backup && adduser -S -G backup backup && mkdir -p /backups && chown backup:backup /backups
USER backup

ENTRYPOINT ["python", "scripts/backup_database.py"]
